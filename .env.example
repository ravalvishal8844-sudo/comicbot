# Скопируйте в .env и заполните

# https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# @BotFather
TELEGRAM_BOT_TOKEN=

# Чат для алертов (необязательно)
ADMIN_CHAT_ID=

# Куки gemini.google.com (F12 → Application → Cookies → .google.com)
